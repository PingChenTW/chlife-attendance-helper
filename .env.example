# Demo uses synthetic names and never contacts the original website.
APP_MODE=demo
HOST=127.0.0.1
PORT=4173
# For live mode, configure group credentials ONLY on the backend host.
# DEFAULT_GROUP=6
GROUP_LINKS_JSON=
# Leave false until a designated real record has been tested.
ALLOW_WRITES=false
# Comma-separated exact browser origins. Blank allows same-origin hosting only.
ALLOWED_ORIGINS=
# Optional persistent random signing key (at least 32 characters).
SNAPSHOT_SECRET=
# Optional durable anonymous usage statistics (server secrets only; never in public/config.js).
# Both unset keeps the restart-reset memory trial. Free Render local files are NOT durable.
USAGE_REDIS_REST_URL=
USAGE_REDIS_REST_TOKEN=
# Optional one-time validated numeric-only migration; see USAGE.md. Leave unset normally.
USAGE_SEED_JSON=
