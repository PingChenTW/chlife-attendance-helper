# Demo uses synthetic names and never contacts the original website.
APP_MODE=demo
HOST=127.0.0.1
PORT=4173
# For live mode, configure these ONLY on the backend host.
CHLIFE_CHURCH_ID=49
CHLIFE_ACCOUNT=
CHLIFE_PASSWORD=
# Leave false until a designated real record has been tested.
ALLOW_WRITES=false
# Comma-separated exact browser origins. Blank allows same-origin hosting only.
ALLOWED_ORIGINS=
# Optional persistent random signing key (at least 32 characters).
SNAPSHOT_SECRET=
